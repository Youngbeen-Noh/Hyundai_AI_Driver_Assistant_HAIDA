#!/bin/sh
# main 에 직접 push 하는 것을 막는다. main 은 PR 을 합칠 때만 바뀐다.
# 켜기: git config core.hooksPath .githooks
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "main 에는 직접 push 할 수 없어요. 브랜치를 만들어 PR 로 올려 주세요. (CONTRIBUTING.md 참고)" >&2
    exit 1
  fi
done
exit 0
