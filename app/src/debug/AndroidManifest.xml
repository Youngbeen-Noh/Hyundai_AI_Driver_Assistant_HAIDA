<?xml version="1.0" encoding="utf-8"?>
<!-- 디버그 빌드에만: 에뮬레이터에서 adb 로 신호를 넣어 보는 수신기. DUMP 권한이 있는 adb shell 만 보낼 수 있다 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- 기능 3: 분위기 신호(시간 · 날씨 · 와이퍼 · 전조등 · 정체) -->
        <receiver
            android:name=".MusicDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="kr.contest.pleosassistant.DEBUG_MUSIC" />
            </intent-filter>
        </receiver>
        <!-- 기능 5: 운전석 안전벨트 미착용 경고 -->
        <receiver
            android:name=".DriveDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="kr.contest.pleosassistant.DEBUG_DRIVE" />
            </intent-filter>
        </receiver>
        <!-- 기능 4: 브리핑 시작 조건(목적지 없이 달린 시간) -->
        <receiver
            android:name=".BriefingDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="kr.contest.pleosassistant.DEBUG_BRIEFING" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
