<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Connect(Android Automotive) 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Pleos 차량 조회 권한 (기능계획서 9장: 필요한 읽기 권한만 신청) -->
    <!-- 기능 1: 오일 · 브레이크액 · 워셔액 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- 기능 1: 연료 · 배터리 잔량 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- 기능 1: 누적 주행거리 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 기능 2: 좌석별 착석 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- 기능 2: 변속 단(P단 = 하차). Vehicle SDK 에 없어 AAOS 표준 CarPropertyManager 로 읽는다(protection: normal) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- 기능 6: 위험 구간 접근 감지. FusedLocation SDK 가 승인되기 전까지 표준 위치로 받는다 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 기능 3: 분위기 보정(와이퍼 → 빗길, 전조등 → 밤길). AAOS 표준 속성으로 읽는다 -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_LIGHTS" />
    <uses-permission android:name="android.car.permission.READ_WINDSHIELD_WIPERS" />
    <!-- 기능 3: 분위기가 바뀌면 이유를 말한다(음성 출력, 차 안 엔진) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 기능 3: 날씨(Open-Meteo). 위치는 대략(약 1km)만 쓴다(위치 권한은 위 기능 6 과 함께) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 기능 3: 차량 음악 앱(스포티파이 · 멜론 · 지니)의 미디어 서비스를 찾아 '검색해서 재생'을 요청한다 -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
        android:name=".HaidaApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PleosAiAssistant">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- 주행 중에도 화면을 보인다(AAOS 주행 중 제한). 주행 중에는 화면이 입력 · 편집을 숨기고 한 문장 · 큰 버튼만 남긴다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
