<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Connect(Android Automotive) 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Pleos 차량 조회 권한 (기능계획서 9장: 필요한 읽기 권한만 신청) -->
    <!-- 기능 1: 오일 · 브레이크액 · 워셔액 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- 기능 1: 연료 · 배터리 잔량 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- 기능 1: 누적 주행거리 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 기능 2: 좌석별 착석 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- 기능 2: 변속 단(P단 = 하차). Vehicle SDK 에 없어 AAOS 표준 CarPropertyManager 로 읽는다(protection: normal) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- 기능 6: 위험 구간 접근 감지. FusedLocation SDK 가 승인되기 전까지 표준 위치로 받는다 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 기능 5: 차속(급가속 · 급감속 · 주행 거리). Pleos 에 API 가 없어 AAOS 표준 PERF_VEHICLE_SPEED 로 읽는다(실행 중 권한) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="pleos.car.permission.CAR_SPEED" />

    <application
        android:name=".HaidaApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PleosAiAssistant">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- 주행 중에도 화면을 띄운다(AAOS 운전 방해 제한). 없으면 D단에서 "주행 중에는 사용할 수 없습니다"로 가려져
                 위험 구간 경고를 못 보여 준다. 주행 중 화면은 기능계획서 9장 원칙(큰 글씨 한 줄 · 버튼 3개 이하)을 지킨다 -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
